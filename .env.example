# Copy this file to .env and fill it in (or set these in your host's dashboard).

# Public address of the site, no trailing slash. Used in emails and payment redirects.
BASE_URL=https://fitplan.example.com
PORT=3000

# Admin page password (/admin). Use a long one.
ADMIN_PASSWORD=

# Random secret for admin logins. Generate with: openssl rand -hex 32
APP_SECRET=

# Where the database file lives. On Railway/Render, point this at the persistent disk.
DB_PATH=./data/fitplan.db

# ---------- Payments ----------
# mock = test mode (nobody is charged) · paymob · stripe
PAYMENT_PROVIDER=mock

# Paymob (Dashboard → Developers / Settings)
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
# Integration IDs to offer at checkout, comma-separated (e.g. card and wallet).
PAYMOB_INTEGRATION_IDS=
# EGP (prices converted with the rate in Admin → Prices & hours) or USD if your account has a USD integration.
PAYMOB_CURRENCY=EGP
# Leave these as they are for Egypt.
PAYMOB_API_URL=https://accept.paymob.com
PAYMOB_CHECKOUT_URL=https://eg.checkout.paymob.com/

# Stripe (only if you use Stripe instead of Paymob)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------- Email (https://resend.com) ----------
RESEND_API_KEY=
MAIL_FROM=Repvo <plans@yourdomain.com>
# Gets a message for every new order, flagged client and missed renewal.
COACH_EMAIL=

# App Store / Google Play reviewers sign in with this email and fixed 6-digit code (no email needed).
# Make one paid order with REVIEW_EMAIL so they see a full plan. Leave empty when not in review.
REVIEW_EMAIL=
REVIEW_CODE=
